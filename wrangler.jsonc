{
  // Cloudflare Worker + 静态资源（Pages/Workers Assets）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jiuyoumap",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // 静态文件（public/）由 Cloudflare 边缘直接返回，Worker 只处理 /api/* 与 /legal/*
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jiuyoumap",
      "database_id": "72f0345f-731a-493a-9baf-0cfc7b0819ca"
    }
  ],

  // 普通变量（Git 部署会按本文件重建）；密钥只放控制台 Secret
  // 白名单不在这里：已存进数据库 settings.test_emails，管理台维护
  "vars": {
    "TDT_TK": "fe66986378af3f8ecbe276808919c8b9",
    "ADMIN_EMAIL": "suyu060416@foxmail.com",
    "MAIL_FROM": "9友地图 <no-reply@jiuyoumap.top>",
    "ALIYUN_DM_ACCOUNT": "no-reply@jiuyoumap.top",
    "ALIYUN_DM_AK_ID": "LTAI5t8BY4q42cXRCkdwyMvU"
  },

  "observability": { "enabled": true }
}
